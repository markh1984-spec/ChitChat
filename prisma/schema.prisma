// Prisma schema for ChitChat

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  bio           String?
  dateOfBirth   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  interests     UserInterest[]
  matches       Match[]        @relation("UserMatches")
  matchedBy     Match[]        @relation("MatchedByUsers")

  @@map("users")
}

model Interest {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  users       UserInterest[]

  @@map("interests")
}

model UserInterest {
  id         String   @id @default(cuid())
  userId     String
  interestId String
  level      Int      @default(5) // 1-10 scale of interest level
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
  @@map("user_interests")
}

model Match {
  id          String   @id @default(cuid())
  userId      String
  matchedId   String
  score       Float    // Matching score 0-100
  status      String   @default("pending") // pending, accepted, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("UserMatches", fields: [userId], references: [id], onDelete: Cascade)
  matched     User     @relation("MatchedByUsers", fields: [matchedId], references: [id], onDelete: Cascade)

  @@unique([userId, matchedId])
  @@map("matches")
}
